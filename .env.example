# The default demo is local and makes no model or network calls.
RAG_BACKEND=demo
RAG_DOCS_DIR=data/sample_docs
RAG_INDEX_DIR=.runtime/index
RAG_MAX_QUESTION_CHARS=4000
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional in development: a private local key is created when blank.
# Required for APP_ENV=production. Never commit a real value.
DJANGO_SECRET_KEY=
APP_ENV=development

# Optional API mode only. Install the api and vector extras first.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_REQUEST_TIMEOUT=30
